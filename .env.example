# Development placeholders only. Never commit a real password or usable production verifier.
AUDIT_ADMIN_USERNAME=replace-with-administrator-username
AUDIT_ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
AUDIT_ADMIN_ROLE=administrator
AUDIT_SESSION_TTL_SECONDS=1800
# Generate a verifier locally: python -c "import bcrypt,getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt()).decode())"
AUDIT_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
AUDIT_TRUSTED_HOSTS=localhost,127.0.0.1,testserver
AUDIT_MAX_REQUEST_BODY_BYTES=65536
AUDIT_LOGIN_RATE_LIMIT=5
AUDIT_MUTATION_RATE_LIMIT=30
AUDIT_RATE_LIMIT_WINDOW_SECONDS=60
AUDIT_HTTPS_REDIRECT=false
